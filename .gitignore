# Whitelist: ignore everything in the project root, then allow only what belongs in the repository.
/*

!/app
!/bootstrap
!/config
!/database
!/public
!/resources
!/routes
!/storage
!/tests

!/.editorconfig
!/.env.example
!/.gitattributes
!/.gitignore
!/.prettierignore
!/.prettierrc
!/artisan
!/components.json
!/composer.json
!/composer.lock
!/eslint.config.js
!/package.json
!/package-lock.json
!/phpunit.xml
!/README.md
!/tailwind.config.js
!/tsconfig.json
!/vite.config.ts

# Generated files inside allowed folders
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/database/*.sqlite
